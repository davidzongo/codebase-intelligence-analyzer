# Example environment configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - only needed for LLM-powered responses)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model selection (optional - defaults to gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# Vector database path (optional - defaults to ./chroma_db)
DB_PATH=./chroma_db

# Number of context snippets to retrieve (optional - defaults to 5)
CONTEXT_SIZE=5
